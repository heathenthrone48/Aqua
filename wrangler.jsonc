{
  "name": "neerbeku",
  "main": "worker.js",
  "compatibility_date": "2026-09-22",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "neer-beku",
      "database_id": "5327a4c7-5291-4f24-8aa8-3e77ef28e6cf"
    }
  ],
  "env": {
    "staging": {
      "name": "neerbeku-staging",
      "workers_dev": true,
      "routes": [],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "neer-beku-staging",
          "database_id": "82e5ab49-a010-4d23-b99f-94d5884ce606",
          "remote": true
        }
      ],
      "vars": {
        "GOOGLE_CLIENT_ID": "851382474898-i55srvunioh0mgc4gv46bgh0mbf2u73g.apps.googleusercontent.com"
      }
    }
  },
  "vars": {
    "MAINTENANCE_MODE": "false"
  }
}
